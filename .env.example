# WhatsOps environment (all optional). Copy to .env or to the systemd EnvironmentFile, chmod 600.
# Everything else (numbers, API keys, webhooks, database, appearance) is set from the config page.

# HTTP listener — keep it on loopback and publish it through a reverse proxy / tunnel
WA_HOST=127.0.0.1
WA_PORT=8810
# Public base URL (OAuth issuer, links in the config page), e.g. https://whatsops.example.com
WA_PUBLIC_URL=
# Data directory (default: ~/.local/share/mcp-mrg-whatsops, macOS: ~/Library/Application Support/mcp-mrg-whatsops)
WA_DATA_DIR=
# Database URL; overrides the one chosen in the config page (sqlite:///path.db | postgres://… | mysql://…)
WA_DB_URL=
# Server language for MCP tools, errors and the WhatsApp login code: en | it (default: OS language)
WA_LANG=
# Logging: trace | debug | info | warn | error
WA_LOG_LEVEL=info
WA_BAILEYS_LOG=
# "System" appearance: path or URL of a desktop theme colors.toml (default: auto-detected)
WA_THEME=

# stdio proxy (`mcp-mrg-whatsops stdio`) for MCP clients that only speak stdio
WA_MCP_URL=http://127.0.0.1:8810/mcp
WA_API_KEY=

# Feedback, crash/malfunction reports and auto-update (defaults: this project's public repo)
# WA_FEEDBACK_REPO=owner/repo
# WA_FEEDBACK_TOKEN=github_pat_...      # fine-grained, only "Issues: read & write" on WA_FEEDBACK_REPO
# WA_UPDATE_REPO=owner/repo
# WA_UPDATE_INTERVAL_MIN=5

# Licenses through Polar: off unless an organization is set (WhatsOps is free)
# WA_POLAR_ORG_ID=
# WA_POLAR_SANDBOX=1
